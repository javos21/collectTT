# Copy to .env.local and adjust. Defaults match docker-compose.yml, so a fresh
# clone needs `cp .env.example .env.local` and nothing else to run locally.

# ---------------------------------------------------------------- database
# Port 5434, not 5432: this machine already runs a native Postgres on 5432 and
# another project's container on 5433. Silently connecting to the wrong database
# server is a miserable hour, so the container gets its own port.
DATABASE_URL="postgres://collecttt:collecttt_dev@localhost:5434/collecttt"

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET="dev-only-secret-replace-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- storage
# Local: MinIO (docker compose). Production: Cloudflare R2 - same S3 API,
# only these values change. No code change.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="collecttt-images"
STORAGE_ACCESS_KEY_ID="collecttt"
STORAGE_SECRET_ACCESS_KEY="collecttt_dev"
STORAGE_FORCE_PATH_STYLE="true"
# Public base URL images are served from. MinIO locally, R2 CDN domain in production.
STORAGE_PUBLIC_URL="http://localhost:9000/collecttt-images"

# ---------------------------------------------------------------- email
# "console" prints magic links + notifications to the terminal (no signup needed).
# Switch to "resend" and set the API key when deploying.
EMAIL_ADAPTER="console"
RESEND_API_KEY=""
EMAIL_FROM="CollectTT <noreply@example.com>"

# ---------------------------------------------------------------- app
NODE_ENV="development"
APP_URL="http://localhost:3000"
