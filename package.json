{
  "name": "collecttt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "build": "next build --webpack",
    "prestart": "npm run db:migrate",
    "start": "next start",
    "prestart:worker": "npm run db:migrate",
    "start:worker": "tsx src/jobs/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:migrate:staging": "node --import tsx scripts/migrate-staging.ts",
    "db:studio": "drizzle-kit studio",
    "storage:cors": "tsx scripts/configure-storage-cors.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "verify": "tsx scripts/verify-phase0.ts",
    "verify:offline": "node --import tsx scripts/verify-offline.ts",
    "verify:launch": "node --import tsx scripts/verify-launch-candidate.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "setup": "npm run db:migrate && npm run seed:categories && npm run storage:cors",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@getbrevo/brevo": "^6.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@untitledui/icons": "^0.0.22",
    "better-auth": "^1.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.16.6",
    "lucide-react": "^1.37.0",
    "next": "^16.3.5",
    "pg": "^8.13.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
